CONFIG_IDF_TARGET="esp32p4"
# M5Stack Tab5 ships with ESP32-P4 rev v1.0; ESP-IDF 5.5 targets rev v3.x by default.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_BSP_LCD_USE_DMA2D=n
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_VIDEO_ENABLE_USB_UVC_VIDEO_DEVICE=n
